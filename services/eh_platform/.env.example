# EH Platform development configuration (PF.3).
# Copy to .env locally — never commit secrets.

EH_ENV=development
EH_HTTP_HOST=0.0.0.0
EH_HTTP_PORT=8080
EH_LOG_LEVEL=info

# PostgreSQL (authoritative platform state — PF-ADR-007)
EH_DATABASE_URL=postgres://eh:eh_dev@127.0.0.1:5432/eh_platform

# Identity lite (PF-ADR-008) — development bearer only.
# Product login providers are intentionally undecided.
EH_DEV_AUTH_TOKEN=dev-platform-token
EH_DEV_USER_ID=00000000-0000-4000-8000-000000000001
EH_DEV_USER_DISPLAY_NAME=Dev User

# AI orchestration seam (PF-ADR-010) — provider credentials stay server-side.
# ai_proxy remains a separate deployable until Phase 8 absorb.
EH_AI_MODE=stub
# OPENAI_API_KEY=  # unused while EH_AI_MODE=stub
