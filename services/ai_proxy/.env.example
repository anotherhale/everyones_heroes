OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_SPEECH_MODEL=tts-1
OPENAI_SPEECH_VOICE=alloy
# HS.12.7 TTS provider selection (proxy/infrastructure only):
# openai | qwen3 | cosyvoice
EH_TTS_PROVIDER=openai
EH_TTS_ALLOW_PROVIDER_HINTS=false
# Local Python sidecar used when EH_TTS_PROVIDER is qwen3 or cosyvoice:
# EH_LOCAL_TTS_URL=http://127.0.0.1:8791
STABILITY_API_KEY=
STABILITY_BASE_URL=https://api.stability.ai
STABILITY_AUDIO_MODEL=stable-audio-3
EH_AI_PROXY_PORT=8787
EH_AI_PROXY_AUTH_TOKEN=
